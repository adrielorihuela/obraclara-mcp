{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obraclara-mcp",
  "main": "src/index.ts",
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "obraclara.adrielorihuela.net", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "obraclara", "database_id": "e35c4c6d-c4cd-4b08-a9bd-9b881ec316b7" }
  ],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "COLA", "class_name": "ColaIA" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ColaGpt"] }, { "tag": "v2", "renamed_classes": [{ "from": "ColaGpt", "to": "ColaIA" }] }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "CHAT_LIMITER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
